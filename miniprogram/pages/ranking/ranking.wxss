/* pages/ranking/ranking.wxss */
.ranking-container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 排序切换 */
.sort-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.sort-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f0f2f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}

.sort-tab.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.loading, .empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-state .icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state text {
  display: block;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.empty-state .hint {
  font-size: 24rpx;
  color: #bbb;
}

/* 排行榜项 */
.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.rank-item.top-1 {
  background: linear-gradient(135deg, #fff9e6, #fff);
  border: 2rpx solid #f5a623;
}

.rank-item.top-2 {
  background: linear-gradient(135deg, #f5f5f5, #fff);
  border: 2rpx solid #bdc3c7;
}

.rank-item.top-3 {
  background: linear-gradient(135deg, #fef5e7, #fff);
  border: 2rpx solid #d35400;
}

.rank-num {
  width: 60rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
}

.rank-info {
  flex: 1;
  margin-left: 16rpx;
}

.rank-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.rank-id {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.rank-stats {
  display: flex;
  gap: 24rpx;
}

.stat-col {
  text-align: center;
}

.stat-val {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.stat-val.highlight {
  color: #667eea;
  font-size: 32rpx;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
