/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 80rpx 40rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.login-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.login-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.login-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
  white-space: pre-line;
}

.login-form {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.15);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #555;
  margin-bottom: 8rpx;
}

.required {
  color: #e74c3c;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.btn-primary, .btn-secondary {
  margin-top: 20rpx;
  font-size: 30rpx;
}

.forgot-link {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 24rpx;
  text-decoration: underline;
}

.current-user {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: #eef2ff;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #444;
  text-align: center;
}

.user-name {
  font-weight: bold;
  color: #667eea;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 32rpx;
}

.modal-desc {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
  line-height: 1.6;
  white-space: pre-line;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  margin-top: 0;
  font-size: 28rpx;
  padding: 20rpx;
}
