/* pages/index/index.wxss */
.index-container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 顶部状态栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.connection-status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.connected .status-dot {
  background: #2ecc71;
}

.connected {
  color: #2ecc71;
}

.disconnected .status-dot {
  background: #e74c3c;
}

.disconnected {
  color: #e74c3c;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-avatar-mini {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #667eea;
}

.user-text {
  text-align: right;
}

.user-nickname {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.user-id {
  display: block;
  font-size: 20rpx;
  color: #999;
}

/* 游戏状态 */
.game-status {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.status-row {
  text-align: center;
}

.status-label {
  font-size: 24rpx;
  color: #888;
}

.status-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  margin-left: 8rpx;
}

/* 玩家卡片 */
.players-area {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.player-card {
  text-align: center;
  padding: 24rpx 16rpx;
  transition: all 0.3s;
}

.player-card.banker {
  border: 4rpx solid #f39c12;
  background: linear-gradient(135deg, #fff9e6, #fff);
}

.player-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.player-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.banker-tag {
  background: #f39c12;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.player-score {
  font-size: 56rpx;
  font-weight: bold;
  margin: 16rpx 0;
}

.score-positive {
  color: #e74c3c;
}

.score-negative {
  color: #27ae60;
}

.player-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.score-btn {
  width: 80rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 12rpx;
}

.score-add {
  background: #e74c3c;
  color: #fff;
}

.score-sub {
  background: #27ae60;
  color: #fff;
}

/* 操作按钮 */
.action-area {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  margin-top: 0;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 85%;
  max-width: 650rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  margin-top: 0;
  font-size: 28rpx;
  padding: 20rpx;
}

/* 结算弹窗 */
.settlement-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.settlement-name {
  font-size: 28rpx;
  color: #333;
}

.settlement-score {
  font-size: 32rpx;
  font-weight: bold;
}

.form-item {
  margin-top: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #555;
  margin-bottom: 12rpx;
}

/* 收款码 */
.pay-body {
  text-align: center;
}

.pay-qrcode {
  width: 400rpx;
  height: 400rpx;
  margin: 20rpx auto;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.no-qrcode {
  padding: 60rpx 0;
  color: #999;
}

.no-qrcode text {
  display: block;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.qrcode-hint {
  font-size: 24rpx !important;
  color: #bbb;
}

.pay-tip {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 16rpx;
}
